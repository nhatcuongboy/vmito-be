# Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-dockerhub-username

# Image versions (managed by CI/CD)
BACKEND_VERSION=staging
FRONTEND_VERSION=staging

# Database
POSTGRES_USER=badminton
POSTGRES_PASSWORD=your-secure-staging-password-here
POSTGRES_DB=badminton_staging

# JWT Authentication
JWT_SECRET=your-staging-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# URLs - Option A: Subdomain (recommended)
FRONTEND_URL=https://staging.vmito.com
BACKEND_URL=https://staging.vmito.com/api
WS_URL=wss://staging.vmito.com

# Password reset email
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@staging.vmito.com
SMTP_PASS=your-smtp-password
ADMIN_EMAIL=admin@staging.vmito.com

# URLs - Option B: Port-based (uncomment if using this option)
# FRONTEND_URL=http://vmito.com:8080
# BACKEND_URL=http://vmito.com:8080/api
# WS_URL=ws://vmito.com:8080

# Google OAuth (use separate OAuth app for staging or same as production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://staging.vmito.com/api/auth/callback/google

# Zalo OAuth v4
ZALO_APP_ID=your-zalo-app-id
ZALO_SECRET_KEY=your-zalo-secret-key
ZALO_CALLBACK_URL=https://staging.vmito.com/api/auth/zalo/callback

# Optional: Gemini AI API Key
GEMINI_API_KEY=

# Cloudinary (can use same as production or separate)
CLOUDINARY_URL=
