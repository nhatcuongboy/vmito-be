generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String? // For email/password auth
  emailVerified DateTime?
  image         String?
  imagePublicId String? // Cloudinary public ID for avatar
  role          Role      @default(PLAYER)

  // Player related information
  gender           Gender?
  level            Int? // Stable level ID from level_definitions
  levelDescription String?
  phone            String?
  searchTerms      String? // Normalized search string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playerRecords      Player[]
  hostedSessions     Session[]             @relation("HostedSessions")
  accounts           Account[]
  sessions           AuthSession[]
  hostedTournaments  Tournament[]          @relation("HostedTournaments")
  managedTournaments TournamentManager[]   @relation("ManagedTournaments")
  tournamentPlayers  TournamentPlayer[]    @relation("TournamentPlayers")
  refreshTokens      RefreshToken[]
  paymentSettings    HostPaymentSettings[]
  hostPayments       PaymentRecord[]       @relation("HostPayments")
  registeredPayments PaymentRecord[]       @relation("RegisteredPayments")
  ratingsGiven       Rating[]              @relation("RatingsGiven")
  ratingsReceived    Rating[]              @relation("RatingsReceived")
  notifications      Notification[]

  // Club relations
  hostedClubs        Club[]              @relation("HostClubs")
  clubMemberships    ClubMember[]        @relation("UserClubs")
  clubMonthlyMembers ClubMonthlyMember[] @relation("UserClubMonthlyMembers")
  clubJoinRequests   ClubJoinRequest[]   @relation("UserClubJoinRequests")
  clubAnnouncements  ClubAnnouncement[]  @relation("UserClubAnnouncements")

  // Image gallery
  uploadedImages UserImage[] @relation("UserImages")

  // Tournament referee (umpire accounts linked to this user)
  refereeUmpires TournamentUmpire[] @relation("RefereeUmpires")

  // Feedback
  feedbacks              Feedback[]     @relation("UserFeedbacks")
  submittedVenueRequests VenueRequest[] @relation("SubmittedVenueRequests")
  reviewedVenueRequests  VenueRequest[] @relation("ReviewedVenueRequests")

  // Venue rental management
  managedVenues      VenueManager[]        @relation("VenueManagers")
  rentalQuotes       VenueRentalQuote[]    @relation("RentalQuoteRequester")
  rentalRequests     VenueRentalRequest[]  @relation("RentalRequester")
  reviewedRentals    VenueRentalRequest[]  @relation("RentalReviewer")
  cancelledRentals   VenueRentalRequest[]  @relation("RentalCanceller")
  rentalProposals    VenueRentalProposal[]
  rentalEvents       VenueRentalEvent[]
  createdCourtBlocks VenueCourtBlock[]     @relation("CourtBlockCreator")
  createdRentals     VenueRentalRequest[]  @relation("RentalCreator")

  // Post relations
  posts        Post[]        @relation("UserPosts")
  postLikes    PostLike[]    @relation("UserPostLikes")
  postComments PostComment[] @relation("UserPostComments")
  postShares   PostShare[]   @relation("UserPostShares")

  // Favorite relations
  favorites Favorite[] @relation("UserFavorites")

  @@map("users")
}

// Notification System
enum NotificationType {
  SYSTEM // Admin broadcast notifications
  SESSION // Session-related notifications
  REGISTRATION // Registration status updates
  PAYMENT // Payment-related notifications
  CLUB // Club-related notifications
  POST // Post interactions (like, comment)
  VENUE_RENTAL // Venue rental workflow updates
  VENUE_REQUEST // Venue request status updates (approved/rejected)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional data (sessionId, playerId, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LevelDescription {
  id          String   @id @default(cuid())
  level       Int      @unique
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("level_descriptions")
}

model LevelDefinition {
  id         Int      @id
  code       String   @unique
  shortLabel String
  sortOrder  Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("level_definitions")
}

model Session {
  id                 String        @id @default(cuid())
  slug               String?       @unique
  name               String
  description        String?
  notes              String?
  hostName           String?
  hostPhone          String?
  location           String? // Keeping for backward compatibility
  venueId            String?
  clubId             String?
  hostId             String
  numberOfCourts     Int           @default(2)
  searchTerms        String? // Normalized search string
  sessionDuration    Int           @default(120)
  maxPlayersPerCourt Int           @default(8)
  requirePlayerInfo  Boolean       @default(true)
  status             SessionStatus @default(PREPARING)
  startTime          DateTime?
  endTime            DateTime?

  // Scheduling fields: planned times vs actual times
  scheduledStartTime DateTime? // Original planned start time
  scheduledEndTime   DateTime? // Original planned end time
  gracePeriodEnd     DateTime? // End of 30-min grace period after scheduledEndTime

  // Notification tracking (prevents duplicate cron notifications)
  startReminderSentAt DateTime? // When start reminder was sent to host
  endWarningSentAt    DateTime? // When 15-min-before-end warning was sent
  cancelledAt         DateTime? // When session was auto-cancelled
  autoStartedAt       DateTime? // When session was auto-started by the system

  // Guest access settings
  allowGuestJoin  Boolean @default(true) // Allow joining without account
  allowNewPlayers Boolean @default(true) // Allow new players to join via session QR

  // Contact settings
  allowZaloContact Boolean @default(false) // Allow players to contact host via Zalo

  // Player level requirements (empty array = all levels allowed)
  requiredLevels Int[] @default([]) // Array of level IDs (empty = all)

  courtColor         String    @default("#179a3b")
  defaultMatchType   MatchType @default(DOUBLES) // Default match type for courts in this session
  coverPhoto         String? // Cloudinary URL for session cover photo
  coverPhotoPublicId String? // Cloudinary public ID for cover photo
  images             String[]  @default([]) // Additional session images (max 5)
  imagePublicIds     String[]  @default([]) // Cloudinary public IDs for additional images
  shuttlecock        String?
  referenceVideoUrl  String?

  // Crawled (vãng lai) sessions imported from public Facebook posts — view-only
  isCrawled            Boolean @default(false) // cờ phân biệt kèo cào Facebook
  externalUrl          String? @unique // link bài FB gốc — chống trùng + điều hướng
  externalSource       String? // nguồn: tên group Facebook / "facebook"
  externalAuthorUrl    String? // link trang cá nhân FB của chủ bài đăng
  externalAuthorAvatar String? // ảnh đại diện FB của chủ bài (hotlink)
  externalGroupUrl     String? // link group Facebook nguồn

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courts    Court[]
  matches   Match[]
  players   Player[]
  host      User     @relation("HostedSessions", fields: [hostId], references: [id])
  venue     Venue?   @relation(fields: [venueId], references: [id])
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  // Fee & Payment relations
  feeConfig           SessionFeeConfig?
  paymentRecords      PaymentRecord[]
  expenses            SessionExpense[]
  ratings             Rating[]
  clubSessions        ClubSession[]
  venueRentalRequests VenueRentalRequest[]

  @@index([isCrawled])
  @@index([clubId])
  @@map("sessions")
}

enum ViewTargetType {
  VENUE
  CLUB
  SESSION
}

model ViewCount {
  id         String         @id @default(cuid())
  targetType ViewTargetType
  targetId   String
  count      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType])
  @@index([targetId])
  @@map("view_counts")
}

enum FavoriteType {
  SESSION
  VENUE
  CLUB
  TOURNAMENT
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  type      FavoriteType
  targetId  String
  createdAt DateTime     @default(now())

  @@unique([userId, type, targetId])
  @@index([userId, type])
  @@index([type, targetId])
  @@map("favorites")
}

model Venue {
  id               String                       @id @default(cuid())
  slug             String?                      @unique
  placeId          String?                      @unique // Google Place ID
  name             String
  sportType        SportType                    @default(BADMINTON)
  acronym          String? // Venue acronym
  description      String? // Venue description
  searchTerms      String? // Normalized search string
  address          String
  streetAddress    String? // House number + street, extracted from `address`; invariant across admin reform, shared by old/new address composition
  lat              Float?
  lng              Float?
  district         String?
  city             String?
  wardOld          String? // Old ward/commune, extracted from `address`
  newAddress       String? // New admin unit address (post Nghị quyết 60) — derived from streetAddress + newDistrict + newCity, not directly editable
  newDistrict      String? // New ward/district name
  newCity          String? // New city/province name if changed
  isVerified       Boolean                      @default(false)
  openingHours     String?
  numberOfCourts   Int?
  status           VenueStatus                  @default(ACTIVE)
  phone            String?
  website          String?
  hourlyRateFixed  Int?
  hourlyRateWalkIn Int?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  sessions         Session[]
  clubs            Club[]
  tournaments      Tournament[]
  tournamentVenues TournamentVenue[]
  venueRequests    VenueRequest[]               @relation("RequestedVenue")
  appliedRequests  VenueRequest[]               @relation("AppliedVenue")
  priceBooks       VenuePriceBook[]
  managers         VenueManager[]
  rentalQuotes     VenueRentalQuote[]
  rentalRequests   VenueRentalRequest[]
  courts           VenueCourt[]
  operatingPeriods VenueOperatingPeriod[]
  courtBlocks      VenueCourtBlock[]
  courtAllocations VenueRentalCourtAllocation[]

  // Amenities
  hasCarParking Boolean?
  hasCanteen    Boolean?
  wifiName      String?
  wifiPassword  String?

  // Status & Policy
  closureStatus         ClosureStatus @default(OPERATING)
  bookingPolicy         String?
  locatedWithin         String?
  timezone              String        @default("Asia/Ho_Chi_Minh")
  rentalEnabled         Boolean       @default(false)
  courtSelectionEnabled Boolean       @default(false)
  scheduleNeedsReview   Boolean       @default(true)

  // Images
  coverPhoto               String?
  coverPhotoPublicId       String?
  courtLayoutImage         String?
  courtLayoutImagePublicId String?
  logo                     String?
  logoPublicId             String?
  images                   String[] @default([])
  imagePublicIds           String[] @default([])

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([lat, lng])
  @@map("venues")
}

enum VenueStatus {
  ACTIVE
  INACTIVE
}

enum ClosureStatus {
  OPERATING
  PERMANENTLY_CLOSED
  TEMPORARILY_CLOSED
}

enum VenueDayType {
  EVERYDAY
  WEEKDAY
  WEEKEND
  HOLIDAY
  SPECIFIC_DATE
}

enum VenueCustomerType {
  FIXED
  WALK_IN
  STUDENT
  MEMBER
  CUSTOM
}

model VenuePriceBook {
  id                 String    @id @default(cuid())
  venueId            String
  name               String
  currency           String    @default("VND")
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isActive           Boolean   @default(true)
  priority           Int       @default(0)
  notes              String?
  priceImageUrl      String?
  priceImagePublicId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  venue        Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rules        VenuePriceRule[]
  rentalQuotes VenueRentalQuote[]

  @@index([venueId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("venue_price_books")
}

model VenuePriceRule {
  id                 String            @id @default(cuid())
  priceBookId        String
  dayType            VenueDayType
  daysOfWeek         Int[]             @default([])
  specificDate       DateTime?
  startMinute        Int
  endMinute          Int
  customerType       VenueCustomerType
  pricePerHour       Int
  minimumMinutes     Int?
  billingStepMinutes Int?
  priority           Int               @default(0)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  priceBook VenuePriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  @@index([priceBookId])
  @@index([dayType])
  @@index([customerType])
  @@map("venue_price_rules")
}

enum VenueManagerRole {
  OWNER
  MANAGER
}

model VenueManager {
  id        String           @id @default(cuid())
  venueId   String
  userId    String
  role      VenueManagerRole @default(MANAGER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation("VenueManagers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([userId])
  @@map("venue_managers")
}

enum VenueCourtStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum VenueCourtBlockType {
  MAINTENANCE
  CLOSED
  PRIVATE_EVENT
  MANUAL_HOLD
}

enum VenueRentalAllocationStatus {
  HELD
  CONFIRMED
  RELEASED
}

model VenueCourt {
  id           String           @id @default(cuid())
  venueId      String
  name         String
  code         String
  status       VenueCourtStatus @default(ACTIVE)
  displayOrder Int              @default(0)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  venue       Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  blocks      VenueCourtBlock[]
  allocations VenueRentalCourtAllocation[]

  @@unique([venueId, code])
  @@index([venueId, status, displayOrder])
  @@map("venue_courts")
}

model VenueOperatingPeriod {
  id          String   @id @default(cuid())
  venueId     String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, dayOfWeek, startMinute])
  @@map("venue_operating_periods")
}

model VenueCourtBlock {
  id              String              @id @default(cuid())
  venueId         String
  courtId         String?
  type            VenueCourtBlockType
  startTime       DateTime
  endTime         DateTime
  reason          String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  venue     Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court     VenueCourt? @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy User        @relation("CourtBlockCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([venueId, startTime, endTime])
  @@index([courtId, startTime, endTime])
  @@map("venue_court_blocks")
}

enum VenueRentalStatus {
  PENDING
  COUNTER_OFFERED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum VenueRentalProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUPERSEDED
  EXPIRED
}

enum VenueRentalEventType {
  CREATED
  APPROVED
  REJECTED
  COUNTER_OFFERED
  PROPOSAL_ACCEPTED
  PROPOSAL_DECLINED
  PROPOSAL_EXPIRED
  CANCELLED
  SESSION_LINKED
  COMPLETED
  MANUAL_CREATED
  COURTS_ALLOCATED
  COURTS_REALLOCATED
}

enum VenueRentalSelectionMode {
  AUTO_ASSIGN
  SELECT_COURTS
}

enum VenueRentalSource {
  ONLINE
  MANUAL
}

model VenueRentalQuote {
  id                String                   @id @default(cuid())
  venueId           String
  requesterId       String
  startTime         DateTime
  endTime           DateTime
  numberOfCourts    Int
  customerType      VenueCustomerType
  currency          String                   @default("VND")
  totalAmount       Int
  priceBookId       String?
  breakdown         Json
  expiresAt         DateTime
  consumedAt        DateTime?
  selectionMode     VenueRentalSelectionMode @default(AUTO_ASSIGN)
  requestedCourtIds String[]                 @default([])
  createdAt         DateTime                 @default(now())

  venue       Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requester   User                         @relation("RentalQuoteRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  priceBook   VenuePriceBook?              @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  request     VenueRentalRequest?
  allocations VenueRentalCourtAllocation[]

  @@index([venueId, startTime, endTime])
  @@index([requesterId, createdAt])
  @@index([expiresAt])
  @@map("venue_rental_quotes")
}

model VenueRentalRequest {
  id                      String                   @id @default(cuid())
  venueId                 String
  requesterId             String?
  quoteId                 String?                  @unique
  createdByUserId         String?
  source                  VenueRentalSource        @default(ONLINE)
  selectionMode           VenueRentalSelectionMode @default(AUTO_ASSIGN)
  requestedCourtIds       String[]                 @default([])
  allocationNeedsReview   Boolean                  @default(false)
  sessionId               String?
  status                  VenueRentalStatus        @default(PENDING)
  contactName             String
  contactPhone            String
  notes                   String?
  rejectionReason         String?
  confirmedStartTime      DateTime?
  confirmedEndTime        DateTime?
  confirmedNumberOfCourts Int?
  confirmedCustomerType   VenueCustomerType?
  confirmedAmount         Int?
  confirmedCurrency       String?
  confirmedBreakdown      Json?
  reviewedByUserId        String?
  cancelledByUserId       String?
  cancellationReason      String?
  confirmedAt             DateTime?
  rejectedAt              DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  venue            Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requester        User?                        @relation("RentalRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  quote            VenueRentalQuote?            @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  createdBy        User?                        @relation("RentalCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  session          Session?                     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reviewedBy       User?                        @relation("RentalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  cancelledBy      User?                        @relation("RentalCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  proposals        VenueRentalProposal[]
  events           VenueRentalEvent[]
  courtAllocations VenueRentalCourtAllocation[]

  @@index([venueId, status, createdAt])
  @@index([venueId, confirmedStartTime, confirmedEndTime])
  @@index([requesterId, createdAt])
  @@index([sessionId])
  @@map("venue_rental_requests")
}

model VenueRentalProposal {
  id                String                    @id @default(cuid())
  requestId         String
  proposedById      String
  startTime         DateTime
  endTime           DateTime
  numberOfCourts    Int
  customerType      VenueCustomerType
  currency          String                    @default("VND")
  totalAmount       Int
  priceBookId       String?
  breakdown         Json
  selectionMode     VenueRentalSelectionMode  @default(AUTO_ASSIGN)
  requestedCourtIds String[]                  @default([])
  status            VenueRentalProposalStatus @default(PENDING)
  expiresAt         DateTime
  respondedAt       DateTime?
  createdAt         DateTime                  @default(now())

  request    VenueRentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy User               @relation(fields: [proposedById], references: [id], onDelete: Restrict)

  @@index([requestId, status, createdAt])
  @@index([expiresAt, status])
  @@map("venue_rental_proposals")
}

model VenueRentalEvent {
  id         String               @id @default(cuid())
  requestId  String
  actorId    String?
  type       VenueRentalEventType
  fromStatus VenueRentalStatus?
  toStatus   VenueRentalStatus?
  payload    Json?
  createdAt  DateTime             @default(now())

  request VenueRentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("venue_rental_events")
}

model VenueRentalCourtAllocation {
  id         String                      @id @default(cuid())
  venueId    String
  courtId    String
  quoteId    String?
  requestId  String?
  startTime  DateTime
  endTime    DateTime
  status     VenueRentalAllocationStatus
  expiresAt  DateTime?
  releasedAt DateTime?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  venue   Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court   VenueCourt          @relation(fields: [courtId], references: [id], onDelete: Restrict)
  quote   VenueRentalQuote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  request VenueRentalRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([venueId, startTime, endTime, status])
  @@index([courtId, startTime, endTime, status])
  @@index([quoteId, status])
  @@index([requestId, status])
  @@map("venue_rental_court_allocations")
}

enum VenueRequestType {
  CREATE
  UPDATE
  PRICE_CORRECTION
  IMAGE_CORRECTION
}

enum VenueRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model VenueRequest {
  id                String             @id @default(cuid())
  type              VenueRequestType
  status            VenueRequestStatus @default(PENDING)
  submittedByUserId String
  venueId           String?
  appliedVenueId    String?
  payload           Json
  adminNote         String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  submittedBy  User   @relation("SubmittedVenueRequests", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?  @relation("ReviewedVenueRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  venue        Venue? @relation("RequestedVenue", fields: [venueId], references: [id], onDelete: SetNull)
  appliedVenue Venue? @relation("AppliedVenue", fields: [appliedVenueId], references: [id], onDelete: SetNull)

  @@index([submittedByUserId])
  @@index([venueId])
  @@index([appliedVenueId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("venue_requests")
}

model Player {
  id                 String             @id @default(cuid())
  sessionId          String
  userId             String? // Linked user account (optional for guests)
  createdByUserId    String? // Track who created this player during registration
  playerNumber       Int
  name               String?
  gender             Gender?
  level              Int? // Stable level ID from level_definitions
  levelDescription   String?
  desire             String?
  phone              String?
  preFilledByHost    Boolean            @default(false)
  confirmedByPlayer  Boolean            @default(false)
  requireConfirmInfo Boolean            @default(false)
  currentWaitTime    Int                @default(0)
  totalWaitTime      Int                @default(0)
  waitingSince       DateTime? // Timestamp when player started waiting (for realtime calculation)
  matchesPlayed      Int                @default(0)
  status             PlayerStatus       @default(WAITING)
  currentCourtId     String?
  courtPosition      Int? // Position on court (0-3), null when not on court
  registrationStatus RegistrationStatus @default(APPROVED)

  // Club fields
  isClubMember   Boolean @default(false)
  clubId         String? // Which club's fee to apply
  clubFeeApplied Boolean @default(false)
  customFee      Int? // Custom fee override for this player in this session only

  // Player-specific join fields
  joinCode   String    @unique // Unique join code for this player slot
  qrCodeData String? // QR code data for this player
  isJoined   Boolean   @default(false) // Whether someone has joined this slot
  isGuest    Boolean   @default(true) // True if joined without account
  joinedAt   DateTime? // When the slot was filled

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  matchPlayers MatchPlayer[]
  currentCourt Court?        @relation(fields: [currentCourtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  club         Club?         @relation(fields: [clubId], references: [id])

  // Payment relation
  paymentRecord PaymentRecord?

  @@unique([sessionId, playerNumber])
  @@index([clubId])
  @@map("players")
}

model Court {
  id                 String         @id @default(cuid())
  sessionId          String
  courtNumber        Int
  courtName          String?
  direction          CourtDirection @default(HORIZONTAL)
  status             CourtStatus    @default(EMPTY)
  currentMatchId     String?        @unique
  preSelectedPlayers Json? // JSON array of pre-selected players with positions
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  currentMatch       Match?         @relation("CurrentMatch", fields: [currentMatchId], references: [id])
  session            Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matches            Match[]        @relation("CourtMatches")
  currentPlayers     Player[]

  @@unique([sessionId, courtNumber])
  @@map("courts")
}

model Match {
  id           String        @id @default(cuid())
  sessionId    String
  courtId      String
  status       MatchStatus   @default(IN_PROGRESS)
  startTime    DateTime      @default(now())
  endTime      DateTime?
  isExtra      Boolean       @default(false) // Indicates match started after session endTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currentCourt Court?        @relation("CurrentMatch")
  players      MatchPlayer[]
  court        Court         @relation("CourtMatches", fields: [courtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Match result
  score            String?
  winnerIds        String?
  isDraw           Boolean? @default(false)
  notes            String?
  shuttlecockCount Float?

  @@map("matches")
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  position Int
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@unique([matchId, position])
  @@map("match_players")
}

enum Role {
  HOST
  PLAYER
  ADMIN
  REFEREE
}

enum SessionStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PlayerStatus {
  WAITING
  PLAYING
  FINISHED
  READY
  INACTIVE
}

enum CourtStatus {
  EMPTY
  IN_USE
  READY
}

enum CourtDirection {
  HORIZONTAL
  VERTICAL
}

enum MatchType {
  SINGLES
  DOUBLES
}

// ... existing enums ...

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  SCHEDULED
  CANCELLED
}

// Tournament Management Models

model Tournament {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  description        String?          @db.Text
  startDate          DateTime
  endDate            DateTime
  hostId             String
  venueId            String?
  status             TournamentStatus @default(PREPARING)
  sportType          SportType        @default(BADMINTON)
  isPublished        Boolean          @default(false)
  scheduleType       ScheduleType?
  coverPhoto         String?
  coverPhotoPublicId String?
  youtubeVideoUrls   String[]         @default([])
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  host             User                      @relation("HostedTournaments", fields: [hostId], references: [id])
  venue            Venue?                    @relation(fields: [venueId], references: [id])
  categories       Category[]
  managers         TournamentManager[]
  umpires          TournamentUmpire[]
  scoringDevices   TournamentScoringDevice[]
  courts           TournamentCourt[]
  players          TournamentPlayer[]
  pairs            TournamentPair[]
  tournamentVenues TournamentVenue[]
  scheduleConfig   ScheduleConfiguration?
  sponsors         TournamentSponsor[]

  @@map("tournaments")
}

// A sponsor displayed on a tournament's public page.
model TournamentSponsor {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  logo         String?
  logoPublicId String?
  website      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_sponsors")
}

enum TournamentStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum SportType {
  BADMINTON
  PICKLEBALL
}

// Per-tournament permission scopes that a host can grant to a manager.
enum TournamentPermission {
  RESULTS // Record results, live scoring, start/end matches, recalc standings
  SCHEDULE // Scheduling, court & referee assignment, umpire management
  PARTICIPANTS // Players, pairs, registrations, group assignment
  STRUCTURE // Categories, format, group creation, generate matches/brackets
}

// A user (other than the host) granted scoped management rights over a tournament.
model TournamentManager {
  id           String                 @id @default(cuid())
  tournamentId String
  userId       String
  permissions  TournamentPermission[]
  addedById    String? // User who granted the access (host or system admin)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("ManagedTournaments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("tournament_managers")
}

enum ScheduleType {
  NEXT_AVAILABLE
  ASSIGNED
}

enum TournamentCourtStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Category {
  id                     String                   @id @default(cuid())
  tournamentId           String
  name                   String
  type                   CategoryType
  registrationMode       CategoryRegistrationMode @default(TEAM)
  teamSize               Int                      @default(2)
  format                 CategoryFormat           @default(ROUND_ROBIN_TO_SE)
  hasGroupStage          Boolean                  @default(false)
  averageMatchDuration   Int?
  groupCount             Int?
  winnersPerGroup        Int?
  playersPerGroup        Int?
  matchFormat            MatchFormat              @default(BEST_OF_3)
  eliminationMatchFormat MatchFormat?
  thirdPlaceMatch        Boolean                  @default(false)
  // Per-set scoring rules. Defaults to BWF (rally to 21, win-by-2, cap 30).
  // pointCap = null means no hard cap (set ends only on winBy gap).
  // Base fields apply to GROUP stage and as fallback for stages without overrides.
  pointsToWin            Int                      @default(21)
  winByTwo               Boolean                  @default(true)
  pointCap               Int?                     @default(30)
  // Per-stage scoring overrides. Null = inherit (knockout falls back to base;
  // final falls back to knockout, then base).
  knockoutPointsToWin    Int?
  knockoutWinByTwo       Boolean?
  knockoutPointCap       Int?
  finalPointsToWin       Int?
  finalWinByTwo          Boolean?
  finalPointCap          Int?
  formatConfig           Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrations CategoryRegistration[]
  groups        CategoryGroup[]
  matches       CategoryMatch[]

  @@unique([tournamentId, name])
  @@map("categories")
}

enum CategoryFormat {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  ROUND_ROBIN_TO_SE
  DOUBLE_ELIMINATION
}

enum MatchFormat {
  BEST_OF_1
  BEST_OF_3
  BEST_OF_5
}

enum CategoryType {
  MENS_SINGLE
  WOMENS_SINGLE
  MENS_DOUBLE
  WOMENS_DOUBLE
  MIXED_DOUBLE
  CUSTOM
}

enum CategoryRegistrationMode {
  INDIVIDUAL
  TEAM
}

model CategoryRegistration {
  id                 String   @id @default(cuid())
  categoryId         String
  tournamentPlayerId String?
  tournamentPairId   String?
  createdAt          DateTime @default(now())

  // Relations
  category           Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  player             TournamentPlayer?           @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)
  pair               TournamentPair?             @relation(fields: [tournamentPairId], references: [id], onDelete: Cascade)
  groupRegistrations CategoryGroupRegistration[]
  matchParticipants  CategoryMatchParticipant[]

  @@unique([categoryId, tournamentPlayerId])
  @@unique([categoryId, tournamentPairId])
  @@map("category_registrations")
}

model CategoryGroup {
  id          String   @id @default(cuid())
  categoryId  String
  groupNumber Int
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category      Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  registrations CategoryGroupRegistration[]
  matches       CategoryMatch[]

  @@unique([categoryId, groupNumber])
  @@map("category_groups")
}

model CategoryGroupRegistration {
  id                     String   @id @default(cuid())
  groupId                String
  categoryRegistrationId String
  createdAt              DateTime @default(now())

  // Relations
  group                CategoryGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([groupId, categoryRegistrationId])
  @@map("category_group_registrations")
}

model CategoryMatch {
  id            String       @id @default(cuid())
  categoryId    String
  groupId       String?
  round         String
  matchNumber   Int
  matchCode     String? // Optional human-readable code (e.g. "M01", "XD-VB01")
  status        MatchStatus  @default(SCHEDULED)
  startTime     DateTime?
  endTime       DateTime?
  courtId       String?
  score         String?
  sets          Json?
  winnerId      String?
  isDraw        Boolean      @default(false)
  isForfeit     Boolean      @default(false) // Decided by forfeit/walkover; winnerId wins, the other side forfeited
  player1Score  Int?
  player2Score  Int?
  player3Score  Int?
  player4Score  Int?
  player1Points Int? // Manually-assigned standings points for side 1 (pointsEarning = 'manual')
  player2Points Int? // Manually-assigned standings points for side 2 (pointsEarning = 'manual')
  matchFormat   MatchFormat? // Match format for this specific match/round
  // Per-match overrides for set scoring rules. Null = inherit from category.
  pointsToWin   Int?
  winByTwo      Boolean?
  pointCap      Int?
  notes         String?
  refereeName   String? // Name entered by the referee when ending the match (separate from assigned TournamentUmpire)

  // Double-elimination bracket linkage. bracketType: 'UPPER' | 'LOWER' | 'GF'.
  // Winner/loser routing is stored explicitly (plain ids, no FK) so advancement
  // does not rely on positional index math (which only works for single elim).
  bracketType       String? // null for single-elim/group matches
  winnerNextMatchId String? // match the winner advances into
  winnerNextSlot    Int? // participant position (1 or 2) in winnerNextMatch
  loserNextMatchId  String? // match the loser drops into (lower bracket / 3rd place)
  loserNextSlot     Int? // participant position (1 or 2) in loserNextMatch

  // Live scoring fields
  refereeId    String? // Assigned referee (TournamentUmpire) for live scoring
  scoreVersion Int     @default(0) // Optimistic lock guard for rapid live updates
  pointLog     Json? // Ordered point history for exact undo (array of { side, setNumber })

  // Pickleball doubles serve state (only used while a PICKLEBALL doubles match
  // is live; null for badminton, pickleball singles, or non-live matches).
  servingSide  Int? // 1 = side 1, 2 = side 2 — which team currently serves
  serverNumber Int? // 1 = first server, 2 = second server

  // Schedule management fields
  queueOrder        Int? // Priority order in queue for Next Available Court mode
  isQueued          Boolean   @default(false) // Whether match is waiting for court assignment
  scheduledDuration Int? // Expected match duration in minutes
  estimatedEndTime  DateTime? // Calculated end time (startTime + scheduledDuration)
  autoAssignedAt    DateTime? // When match was auto-assigned to court
  assignedBy        String? // "AUTO" or userId who manually assigned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category          Category                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group             CategoryGroup?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  court             TournamentCourt?           @relation("CourtMatches", fields: [courtId], references: [id])
  currentCourtMatch TournamentCourt?           @relation("CurrentCourtMatch")
  referee           TournamentUmpire?          @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  participants      CategoryMatchParticipant[]

  @@index([refereeId])
  @@map("category_matches")
}

model CategoryMatchParticipant {
  id                     String   @id @default(cuid())
  matchId                String
  categoryRegistrationId String
  position               Int
  createdAt              DateTime @default(now())

  // Relations
  match                CategoryMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([matchId, categoryRegistrationId])
  @@unique([matchId, position])
  @@map("category_match_participants")
}

model TournamentUmpire {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  email        String?
  phone        String?
  notes        String?
  userId       String? // Linked user account (makes this umpire a login-able referee)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?           @relation("RefereeUmpires", fields: [userId], references: [id], onDelete: SetNull)
  matches    CategoryMatch[] @relation("MatchReferee")

  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_umpires")
}

model TournamentScoringDevice {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  deviceType   String?
  deviceId     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_scoring_devices")
}

model TournamentCourt {
  id                String                @id @default(cuid())
  tournamentId      String
  tournamentVenueId String?
  courtNumber       Int
  courtName         String?
  status            TournamentCourtStatus @default(AVAILABLE)
  currentMatchId    String?               @unique
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentVenue TournamentVenue? @relation(fields: [tournamentVenueId], references: [id], onDelete: SetNull)
  matches         CategoryMatch[]  @relation("CourtMatches")
  currentMatch    CategoryMatch?   @relation("CurrentCourtMatch", fields: [currentMatchId], references: [id])
  courtTimeSlots  CourtTimeSlot[]

  @@unique([tournamentId, courtNumber])
  @@map("tournament_courts")
}

model TournamentVenue {
  id           String   @id @default(cuid())
  tournamentId String
  /// Null when using inline address mode (no Venue record created)
  venueId      String?
  createdAt    DateTime @default(now())

  /// Inline address fields — populated when venueId is null
  name     String?
  acronym  String?
  placeId  String?
  address  String?
  lat      Float?
  lng      Float?
  district String?
  city     String?

  // Relations
  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venue      Venue?            @relation(fields: [venueId], references: [id])
  courts     TournamentCourt[]

  @@map("tournament_venues")
}

model TournamentPlayer {
  id               String   @id @default(cuid())
  tournamentId     String
  name             String
  code             String? // Human-readable player code (e.g. "VDV001", "XD01")
  email            String?
  phone            String?
  gender           Gender?
  level            Int?
  levelDescription String?
  notes            String?
  image            String? // Cloudinary URL for avatar
  imagePublicId    String? // Cloudinary public ID for avatar
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                  @relation("TournamentPlayers", fields: [userId], references: [id])
  registrations CategoryRegistration[]
  pairMembers   TournamentPairMember[]

  @@map("tournament_players")
}

model TournamentPair {
  id           String        @id @default(cuid())
  tournamentId String
  name         String?
  type         CategoryType?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members       TournamentPairMember[]
  registrations CategoryRegistration[]

  @@map("tournament_pairs")
}

model TournamentPairMember {
  id        String   @id @default(cuid())
  pairId    String
  playerId  String
  position  Int
  createdAt DateTime @default(now())

  // Relations
  pair   TournamentPair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  player TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([pairId, playerId])
  @@unique([pairId, position])
  @@map("tournament_pair_members")
}

// ===========================================
// Fee & Payment Management Models
// ===========================================

enum FeeType {
  FIXED
  SPLIT_EVENLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model SessionFeeConfig {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  feeType        FeeType
  maleFee        Int? // Fee for male players (in VND), nullable for SPLIT_EVENLY
  femaleFee      Int? // Fee for female players (in VND), nullable for SPLIT_EVENLY
  splitTotal     Int? // Total amount to split (for SPLIT_EVENLY), set after session
  splitPerPlayer Int? // Calculated amount per player (for SPLIT_EVENLY)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_fee_configs")
}

model HostPaymentSettings {
  id                String   @id @default(cuid())
  userId            String
  bankName          String?
  bankAccountNumber String?
  accountHolderName String?
  qrCodeUrl         String?
  qrCodePublicId    String? // Cloudinary public ID for QR code
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("host_payment_settings")
}

model PaymentRecord {
  id                 String         @id @default(cuid())
  sessionId          String
  playerId           String         @unique // One payment per player
  registeredByUserId String? // User who registered this player (for multi-slot)
  hostId             String
  amount             Int // Amount in VND
  paymentMethod      PaymentMethod?
  status             PaymentStatus  @default(PENDING)
  proofImageUrl      String?
  proofImagePublicId String? // Cloudinary public ID for payment proof
  proofNotes         String?
  hostNotes          String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  host         User    @relation("HostPayments", fields: [hostId], references: [id])
  registeredBy User?   @relation("RegisteredPayments", fields: [registeredByUserId], references: [id])

  @@index([sessionId])
  @@index([hostId])
  @@index([registeredByUserId])
  @@map("payment_records")
}

model SessionExpense {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  amount    Int // Amount in VND
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_expenses")
}

// ===========================================
// Rating & Review System Models
// ===========================================

enum RatingType {
  PLAYER_TO_HOST
  HOST_TO_PLAYER
}

model Rating {
  id          String     @id @default(cuid())
  sessionId   String
  raterUserId String // User giving the rating
  ratedUserId String // User receiving the rating
  type        RatingType // Direction of rating
  rating      Int // 1-5 stars
  comment     String? // Optional review (max 500 chars)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater   User    @relation("RatingsGiven", fields: [raterUserId], references: [id], onDelete: Cascade)
  rated   User    @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  // Unique constraint: one rating per (session, rater, rated, type)
  @@unique([sessionId, raterUserId, ratedUserId, type])
  @@index([ratedUserId])
  @@index([raterUserId])
  @@index([sessionId])
  @@map("ratings")
}

// ===========================================
// Fixed Member Group Management Models
// ===========================================

model Club {
  id          String  @id @default(cuid())
  slug        String? @unique
  hostId      String
  name        String // "VIP", "Thường xuyên", etc.
  hostName    String? // Provisional host name set by admin (not linked to a real user yet)
  description String?
  color       String? // Color for visual distinction
  searchTerms String? // Normalized search string

  // Club visibility and access settings
  isPublic       Boolean        @default(false)
  joinPolicy     ClubJoinPolicy @default(APPROVAL_REQUIRED)
  maxMembers     Int?
  image          String? // Cloudinary URL for club image (primary/cover)
  imagePublicId  String? // Cloudinary public ID (primary/cover)
  logo           String? // Cloudinary URL for club logo/avatar (distinct from cover)
  logoPublicId   String? // Cloudinary public ID for logo
  images         String[]       @default([]) // Multiple images functionality
  imagePublicIds String[]       @default([]) // Multiple image public IDs
  location       String? // Primary location/venue
  defaultVenueId String? // Link to default venue
  requiredLevels Int[]          @default([]) // Array of level IDs (empty = all)
  socialLinks    Json? // Social media links (facebook, zalo, tiktok, instagram, youtube, website, other)

  // Statistics (cached for performance)
  sessionCount       Int @default(0)
  totalPlayersServed Int @default(0)

  status          ClubStatus @default(APPROVED)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host           User                @relation("HostClubs", fields: [hostId], references: [id], onDelete: Cascade)
  defaultVenue   Venue?              @relation(fields: [defaultVenueId], references: [id], onDelete: SetNull)
  members        ClubMember[]
  feeConfigs     ClubFeeConfig[]
  monthlyMembers ClubMonthlyMember[]
  players        Player[]
  sessions       Session[]
  joinRequests   ClubJoinRequest[]
  announcements  ClubAnnouncement[]
  clubSessions   ClubSession[]
  schedules      ClubSchedule[]

  @@unique([hostId, name])
  @@index([hostId])
  @@index([isPublic])
  @@map("clubs")
}

model ClubMember {
  id     String @id @default(cuid())
  clubId String
  userId String

  // Member role and status
  role   MemberRole   @default(MEMBER)
  status MemberStatus @default(ACTIVE)

  // Activity tracking
  attendanceCount Int       @default(0)
  lastAttendedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("UserClubs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId])
  @@index([role])
  @@index([status])
  @@map("club_members")
}

model ClubFeeConfig {
  id                  String   @id @default(cuid())
  clubId              String
  month               Int // Month (1-12)
  year                Int // Year
  maleFeeMonthly      Int? // Total monthly fee for males (for tracking)
  femaleFeeMonthly    Int? // Total monthly fee for females (for tracking)
  maleFeePerSession   Int? // Per-session fee for males (used in PaymentRecord)
  femaleFeePerSession Int? // Per-session fee for females (used in PaymentRecord)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, month, year])
  @@index([clubId])
  @@map("club_fee_configs")
}

model ClubMonthlyMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("UserClubMonthlyMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, month, year])
  @@index([clubId, month, year])
  @@index([userId])
  @@map("club_monthly_members")
}

// ===========================================
// Club Management Enums
// ===========================================

enum ClubJoinPolicy {
  OPEN // Anyone can join immediately
  APPROVAL_REQUIRED // Requires admin approval
  INVITATION_ONLY // Only invited users can join
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===========================================
// Club Join Request Model
// ===========================================

model ClubJoinRequest {
  id        String            @id @default(cuid())
  clubId    String
  userId    String
  message   String? // Optional message from requester
  status    JoinRequestStatus @default(PENDING)
  response  String? // Optional response from admin
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("UserClubJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([status])
  @@map("club_join_requests")
}

// ===========================================
// Club Announcement Model
// ===========================================

model ClubAnnouncement {
  id          String    @id @default(cuid())
  clubId      String
  authorId    String
  title       String
  content     String    @db.Text
  pinnedUntil DateTime? // Optional pinning expiration
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation("UserClubAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([authorId])
  @@index([pinnedUntil])
  @@map("club_announcements")
}

// ===========================================
// Club Session Tracking Model
// ===========================================

model ClubSession {
  id              String   @id @default(cuid())
  clubId          String
  sessionId       String
  attendanceCount Int      @default(0) // Number of club members who attended
  createdAt       DateTime @default(now())

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([clubId, sessionId])
  @@index([clubId])
  @@index([sessionId])
  @@map("club_sessions")
}

// ===========================================
// Club Schedule Model
// ===========================================

model ClubSchedule {
  id        String  @id @default(cuid())
  clubId    String
  dayOfWeek Int // 0=CN, 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7
  startTime String // "19:00"
  endTime   String // "21:00"
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_schedules")
}

// ===========================================
// User Image Gallery (Feature: multi-image upload)
// ===========================================

enum ImageCategory {
  SESSION_COVER
  AVATAR
  CLUB
  QR_CODE
  PAYMENT_PROOF
  OTHER
}

model UserImage {
  id           String        @id @default(cuid())
  userId       String
  url          String // Cloudinary secure URL
  publicId     String // Cloudinary public ID
  originalName String? // Original filename
  format       String? // jpg, png, webp, etc.
  width        Int?
  height       Int?
  bytes        Int?
  category     ImageCategory @default(OTHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserImages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@map("user_images")
}

// ===========================================
// Newsfeed / Post System Models
// ===========================================

enum PostType {
  USER
  ACTIVITY
}

enum PostVisibility {
  PUBLIC
  FRIENDS // reserved for the future friend system
  PRIVATE
}

enum ActivityType {
  SESSION_CREATED
  SESSION_RESULTS
  CLUB_CREATED
  CLUB_UPDATED
  CLUB_MEMBER_JOINED
  TOURNAMENT_CREATED
  TOURNAMENT_FINISHED
  AVATAR_UPDATED
  USER_RATED
}

model Post {
  id       String  @id @default(cuid())
  content  String  @db.Text
  videoUrl String? // YouTube/Vimeo embed URL
  location Json? // {name, lat, lng, address}
  authorId String
  author   User    @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  // Activity feed (auto-generated posts)
  type         PostType       @default(USER)
  activityType ActivityType?
  metadata     Json? // shape depends on activityType, see src/activities/activity-metadata.types.ts
  visibility   PostVisibility @default(PUBLIC)

  images   PostImage[]
  likes    PostLike[]
  comments PostComment[]
  shares   PostShare[]

  // For repost/share
  originalPostId String?
  originalPost   Post?   @relation("PostShares", fields: [originalPostId], references: [id])
  reposts        Post[]  @relation("PostShares")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([type, activityType])
  @@map("posts")
}

model PostImage {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  publicId String
  order    Int    @default(0)

  @@index([postId])
  @@map("post_images")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("UserPostComments", fields: [userId], references: [id], onDelete: Cascade)
  content       String   @db.Text
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostShares", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_shares")
}

// ===========================================
// Tournament Schedule Generator Models
// ===========================================

model ScheduleConfiguration {
  id                   String   @id @default(cuid())
  tournamentId         String   @unique
  categoryPriorities   Json // Ordered array of category IDs
  matchDurations       Json // { "POOL_PLAY": 60, "PLAYOFFS": 60 }
  keepScheduledMatches Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  timeSlots  ScheduleTimeSlot[]

  @@map("schedule_configurations")
}

model ScheduleTimeSlot {
  id         String   @id @default(cuid())
  configId   String
  date       DateTime
  startTime  String // "09:00"
  endTime    String // "17:00"
  timeBuffer Int      @default(0) // minutes between matches
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  configuration ScheduleConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)
  courtSlots    CourtTimeSlot[]

  @@map("schedule_time_slots")
}

model CourtTimeSlot {
  id          String   @id @default(cuid())
  timeSlotId  String
  courtId     String
  constraints Json? // { categories?: string[], rounds?: string[], groups?: string[] }
  createdAt   DateTime @default(now())

  timeSlot ScheduleTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  court    TournamentCourt  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([timeSlotId, courtId])
  @@map("court_time_slots")
}

model GeneratedSchedule {
  id             String   @id @default(cuid())
  tournamentId   String
  configSnapshot Json // Full configuration snapshot
  assignments    Json // Array of { matchId, courtId, startTime, duration }
  conflicts      Json // Array of unresolved conflicts
  createdAt      DateTime @default(now())
  expiresAt      DateTime // Auto-delete after 1 hour

  @@index([tournamentId])
  @@index([expiresAt])
  @@map("generated_schedules")
}

// Feedback & Bug Report System
enum FeedbackType {
  CONTACT
  BUG_REPORT
}

enum FeedbackStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id            String         @id @default(cuid())
  type          FeedbackType
  userId        String
  title         String
  description   String         @db.Text
  imageUrl      String? // Screenshot URL
  imagePublicId String? // Cloudinary public ID
  status        FeedbackStatus @default(PENDING)
  adminNote     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation("UserFeedbacks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("feedbacks")
}
