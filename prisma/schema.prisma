generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String? // For email/password auth
  emailVerified DateTime?
  image         String?
  imagePublicId String? // Cloudinary public ID for avatar
  role          Role      @default(PLAYER)

  // Player related information
  gender           Gender?
  level            Int?      // 1-7 (Beginner to Pro)
  levelDescription String?
  phone            String?
  searchTerms      String?   // Normalized search string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playerRecords       Player[]
  hostedSessions      Session[]              @relation("HostedSessions")
  accounts            Account[]
  sessions            AuthSession[]
  hostedTournaments   Tournament[]           @relation("HostedTournaments")
  tournamentPlayers   TournamentPlayer[]     @relation("TournamentPlayers")
  refreshTokens       RefreshToken[]
  paymentSettings     HostPaymentSettings[]
  hostPayments        PaymentRecord[]        @relation("HostPayments")
  registeredPayments  PaymentRecord[]        @relation("RegisteredPayments")
  ratingsGiven        Rating[]               @relation("RatingsGiven")
  ratingsReceived     Rating[]               @relation("RatingsReceived")
  notifications       Notification[]

  // Club relations
  hostedClubs Club[] @relation("HostClubs")
  clubMemberships ClubMember[] @relation("UserClubs")
  clubJoinRequests ClubJoinRequest[] @relation("UserClubJoinRequests")
  clubAnnouncements ClubAnnouncement[] @relation("UserClubAnnouncements")

  @@map("users")
}

// Notification System
enum NotificationType {
  SYSTEM        // Admin broadcast notifications
  SESSION       // Session-related notifications
  REGISTRATION  // Registration status updates
  PAYMENT       // Payment-related notifications
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?            // Additional data (sessionId, playerId, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Session {
  id                 String        @id @default(cuid())
  name               String
  description        String?
  hostName           String?
  hostPhone          String?
  location           String?       // Keeping for backward compatibility
  venueId            String?
  hostId             String
  numberOfCourts     Int           @default(2)
  searchTerms        String?       // Normalized search string
  sessionDuration    Int           @default(120)
  maxPlayersPerCourt Int           @default(8)
  requirePlayerInfo  Boolean       @default(true)
  status             SessionStatus @default(PREPARING)
  startTime          DateTime?
  endTime            DateTime?

  // Guest access settings
  allowGuestJoin  Boolean @default(true) // Allow joining without account
  allowNewPlayers Boolean @default(true) // Allow new players to join via session QR

  // Player level requirements (empty array = all levels allowed)
  requiredLevels Int[] @default([]) // Array of level IDs (1-7)

  courtColor       String  @default("#179a3b")
  coverPhoto       String? // Cloudinary URL for session cover photo
  coverPhotoPublicId String? // Cloudinary public ID for cover photo
  shuttlecock        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courts    Court[]
  matches   Match[]
  players   Player[]
  host      User     @relation("HostedSessions", fields: [hostId], references: [id])
  venue     Venue?   @relation(fields: [venueId], references: [id])

  // Fee & Payment relations
  feeConfig      SessionFeeConfig?
  paymentRecords PaymentRecord[]
  ratings        Rating[]
  clubSessions   ClubSession[]

  @@map("sessions")
}

model Venue {
  id             String      @id @default(cuid())
  placeId        String      @unique // Google Place ID
  name           String
  searchTerms    String?     // Normalized search string
  address        String
  lat            Float?
  lng            Float?
  district       String?
  city           String?
  isVerified     Boolean     @default(false)
  openingHours   String?
  numberOfCourts Int?
  status         VenueStatus @default(ACTIVE)
  phone          String?
  website        String?
  hourlyRateFixed  Int?
  hourlyRateWalkIn Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sessions       Session[]
  clubs          Club[]

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([lat, lng])
  @@map("venues")
}

enum VenueStatus {
  ACTIVE
  INACTIVE
}

model Player {
  id                 String       @id @default(cuid())
  sessionId          String
  userId             String? // Linked user account (optional for guests)
  createdByUserId    String? // Track who created this player during registration
  playerNumber       Int
  name               String?
  gender             Gender?
  level              Int?         // 1-7 (Beginner to Pro)
  levelDescription   String?
  desire             String?
  phone              String?
  preFilledByHost    Boolean      @default(false)
  confirmedByPlayer  Boolean      @default(false)
  requireConfirmInfo Boolean      @default(false)
  currentWaitTime    Int          @default(0)
  totalWaitTime      Int          @default(0)
  waitingSince       DateTime?    // Timestamp when player started waiting (for realtime calculation)
  matchesPlayed      Int          @default(0)
  status             PlayerStatus @default(WAITING)
  currentCourtId     String?
  courtPosition      Int? // Position on court (0-3), null when not on court
  registrationStatus RegistrationStatus @default(APPROVED)

  // Club fields
  isClubMember           Boolean  @default(false)
  clubId                 String?  // Which club's fee to apply
  clubFeeApplied         Boolean  @default(false)

  // Player-specific join fields
  joinCode   String    @unique // Unique join code for this player slot
  qrCodeData String? // QR code data for this player
  isJoined   Boolean   @default(false) // Whether someone has joined this slot
  isGuest    Boolean   @default(true) // True if joined without account
  joinedAt   DateTime? // When the slot was filled

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  matchPlayers MatchPlayer[]
  currentCourt Court?        @relation(fields: [currentCourtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  club Club? @relation(fields: [clubId], references: [id])

  // Payment relation
  paymentRecord PaymentRecord?

  @@unique([sessionId, playerNumber])
  @@index([clubId])
  @@map("players")
}

model Court {
  id                 String         @id @default(cuid())
  sessionId          String
  courtNumber        Int
  courtName          String?
  direction          CourtDirection @default(HORIZONTAL)
  status             CourtStatus    @default(EMPTY)
  currentMatchId     String?        @unique
  preSelectedPlayers Json? // JSON array of pre-selected players with positions
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  currentMatch       Match?         @relation("CurrentMatch", fields: [currentMatchId], references: [id])
  session            Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matches            Match[]        @relation("CourtMatches")
  currentPlayers     Player[]

  @@unique([sessionId, courtNumber])
  @@map("courts")
}

model Match {
  id           String        @id @default(cuid())
  sessionId    String
  courtId      String
  status       MatchStatus   @default(IN_PROGRESS)
  startTime    DateTime      @default(now())
  endTime      DateTime?
  isExtra      Boolean       @default(false) // Indicates match started after session endTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currentCourt Court?        @relation("CurrentMatch")
  players      MatchPlayer[]
  court        Court         @relation("CourtMatches", fields: [courtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Match result
  score     String?
  winnerIds String?
  isDraw    Boolean? @default(false)
  notes     String?

  @@map("matches")
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  position Int
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@unique([matchId, position])
  @@map("match_players")
}

enum Role {
  HOST
  PLAYER
  ADMIN
}

enum SessionStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PlayerStatus {
  WAITING
  PLAYING
  FINISHED
  READY
  INACTIVE
}

enum CourtStatus {
  EMPTY
  IN_USE
  READY
}

enum CourtDirection {
  HORIZONTAL
  VERTICAL
}

// ... existing enums ...

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  SCHEDULED
  CANCELLED
}

// Tournament Management Models

model Tournament {
  id        String           @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  hostId    String
  status    TournamentStatus @default(PREPARING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  host           User                      @relation("HostedTournaments", fields: [hostId], references: [id])
  categories     Category[]
  umpires        TournamentUmpire[]
  scoringDevices TournamentScoringDevice[]
  courts         TournamentCourt[]
  players        TournamentPlayer[]
  pairs          TournamentPair[]

  @@map("tournaments")
}

enum TournamentStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Category {
  id                   String       @id @default(cuid())
  tournamentId         String
  name                 String
  type                 CategoryType
  hasGroupStage        Boolean      @default(false)
  averageMatchDuration Int?
  groupCount           Int?
  winnersPerGroup      Int?
  playersPerGroup      Int?
  matchFormat          MatchFormat  @default(BEST_OF_3)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrations CategoryRegistration[]
  groups        CategoryGroup[]
  matches       CategoryMatch[]

  @@unique([tournamentId, name])
  @@map("categories")
}

enum MatchFormat {
  BEST_OF_1
  BEST_OF_3
}

enum CategoryType {
  MENS_SINGLE
  WOMENS_SINGLE
  MENS_DOUBLE
  WOMENS_DOUBLE
  MIXED_DOUBLE
}

model CategoryRegistration {
  id                 String   @id @default(cuid())
  categoryId         String
  tournamentPlayerId String?
  tournamentPairId   String?
  createdAt          DateTime @default(now())

  // Relations
  category           Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  player             TournamentPlayer?           @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)
  pair               TournamentPair?             @relation(fields: [tournamentPairId], references: [id], onDelete: Cascade)
  groupRegistrations CategoryGroupRegistration[]
  matchParticipants  CategoryMatchParticipant[]

  @@unique([categoryId, tournamentPlayerId])
  @@unique([categoryId, tournamentPairId])
  @@map("category_registrations")
}

model CategoryGroup {
  id          String   @id @default(cuid())
  categoryId  String
  groupNumber Int
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category      Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  registrations CategoryGroupRegistration[]
  matches       CategoryMatch[]

  @@unique([categoryId, groupNumber])
  @@map("category_groups")
}

model CategoryGroupRegistration {
  id                     String   @id @default(cuid())
  groupId                String
  categoryRegistrationId String
  createdAt              DateTime @default(now())

  // Relations
  group                CategoryGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([groupId, categoryRegistrationId])
  @@map("category_group_registrations")
}

model CategoryMatch {
  id           String       @id @default(cuid())
  categoryId   String
  groupId      String?
  round        String
  matchNumber  Int
  status       MatchStatus  @default(SCHEDULED)
  startTime    DateTime?
  endTime      DateTime?
  courtId      String?
  score        String?
  sets         Json?
  winnerId     String?
  isDraw       Boolean      @default(false)
  player1Score Int?
  player2Score Int?
  player3Score Int?
  player4Score Int?
  matchFormat  MatchFormat? // Match format for this specific match/round
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  category     Category                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group        CategoryGroup?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  court        TournamentCourt?           @relation(fields: [courtId], references: [id])
  participants CategoryMatchParticipant[]

  @@map("category_matches")
}

model CategoryMatchParticipant {
  id                     String   @id @default(cuid())
  matchId                String
  categoryRegistrationId String
  position               Int
  createdAt              DateTime @default(now())

  // Relations
  match                CategoryMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([matchId, categoryRegistrationId])
  @@unique([matchId, position])
  @@map("category_match_participants")
}

model TournamentUmpire {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_umpires")
}

model TournamentScoringDevice {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  deviceType   String?
  deviceId     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_scoring_devices")
}

model TournamentCourt {
  id           String   @id @default(cuid())
  tournamentId String
  courtNumber  Int
  courtName    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    CategoryMatch[]

  @@unique([tournamentId, courtNumber])
  @@map("tournament_courts")
}

model TournamentPlayer {
  id               String   @id @default(cuid())
  tournamentId     String
  name             String
  email            String?
  phone            String?
  gender           Gender?
  level            Int?
  levelDescription String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                  @relation("TournamentPlayers", fields: [userId], references: [id])
  registrations CategoryRegistration[]
  pairMembers   TournamentPairMember[]

  @@map("tournament_players")
}

model TournamentPair {
  id           String        @id @default(cuid())
  tournamentId String
  name         String?
  type         CategoryType?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members       TournamentPairMember[]
  registrations CategoryRegistration[]

  @@map("tournament_pairs")
}

model TournamentPairMember {
  id        String   @id @default(cuid())
  pairId    String
  playerId  String
  position  Int
  createdAt DateTime @default(now())

  // Relations
  pair   TournamentPair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  player TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([pairId, playerId])
  @@unique([pairId, position])
  @@map("tournament_pair_members")
}

// ===========================================
// Fee & Payment Management Models
// ===========================================

enum FeeType {
  FIXED
  SPLIT_EVENLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model SessionFeeConfig {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  feeType        FeeType
  maleFee        Int? // Fee for male players (in VND), nullable for SPLIT_EVENLY
  femaleFee      Int? // Fee for female players (in VND), nullable for SPLIT_EVENLY
  splitTotal     Int? // Total amount to split (for SPLIT_EVENLY), set after session
  splitPerPlayer Int? // Calculated amount per player (for SPLIT_EVENLY)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_fee_configs")
}

model HostPaymentSettings {
  id                String   @id @default(cuid())
  userId            String
  bankName          String?
  bankAccountNumber String?
  accountHolderName String?
  qrCodeUrl         String?
  qrCodePublicId    String? // Cloudinary public ID for QR code
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("host_payment_settings")
}

model PaymentRecord {
  id                 String         @id @default(cuid())
  sessionId          String
  playerId           String         @unique // One payment per player
  registeredByUserId String? // User who registered this player (for multi-slot)
  hostId             String
  amount             Int // Amount in VND
  paymentMethod      PaymentMethod?
  status             PaymentStatus  @default(PENDING)
  proofImageUrl      String?
  proofImagePublicId String? // Cloudinary public ID for payment proof
  proofNotes         String?
  hostNotes          String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player         Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  host           User    @relation("HostPayments", fields: [hostId], references: [id])
  registeredBy   User?   @relation("RegisteredPayments", fields: [registeredByUserId], references: [id])

  @@index([sessionId])
  @@index([hostId])
  @@index([registeredByUserId])
  @@map("payment_records")
}

// ===========================================
// Rating & Review System Models
// ===========================================

enum RatingType {
  PLAYER_TO_HOST
  HOST_TO_PLAYER
}

model Rating {
  id          String     @id @default(cuid())
  sessionId   String
  raterUserId String     // User giving the rating
  ratedUserId String     // User receiving the rating
  type        RatingType // Direction of rating
  rating      Int        // 1-5 stars
  comment     String?    // Optional review (max 500 chars)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater     User    @relation("RatingsGiven", fields: [raterUserId], references: [id], onDelete: Cascade)
  rated     User    @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  // Unique constraint: one rating per (session, rater, rated, type)
  @@unique([sessionId, raterUserId, ratedUserId, type])
  @@index([ratedUserId])
  @@index([raterUserId])
  @@index([sessionId])
  @@map("ratings")
}

// ===========================================
// Fixed Member Group Management Models
// ===========================================

model Club {
  id          String   @id @default(cuid())
  hostId      String
  name        String   // "VIP", "Thường xuyên", etc.
  description String?
  color       String?  // Color for visual distinction
  searchTerms String?  // Normalized search string
  
  // Club visibility and access settings
  isPublic    Boolean  @default(false)
  joinPolicy  ClubJoinPolicy @default(APPROVAL_REQUIRED)
  maxMembers  Int?
  image       String?  // Cloudinary URL for club image
  imagePublicId String? // Cloudinary public ID
  location    String?  // Primary location/venue
  defaultVenueId String? // Link to default venue
  
  // Statistics (cached for performance)
  sessionCount Int @default(0)
  totalPlayersServed Int @default(0)
  
  status      ClubStatus @default(APPROVED)
  rejectionReason String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host         User                          @relation("HostClubs", fields: [hostId], references: [id], onDelete: Cascade)
  defaultVenue Venue?                        @relation(fields: [defaultVenueId], references: [id], onDelete: SetNull)
  members      ClubMember[]
  feeConfigs   ClubFeeConfig[]
  players      Player[]
  joinRequests ClubJoinRequest[]
  announcements ClubAnnouncement[]
  clubSessions ClubSession[]
  schedules    ClubSchedule[]

  @@unique([hostId, name])
  @@index([hostId])
  @@index([isPublic])
  @@map("clubs")
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  
  // Member role and status
  role      MemberRole   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  
  // Activity tracking
  attendanceCount Int @default(0)
  lastAttendedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club  Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user  User @relation("UserClubs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId])
  @@index([role])
  @@index([status])
  @@map("club_members")
}

model ClubFeeConfig {
  id                  String   @id @default(cuid())
  clubId              String
  month               Int      // Month (1-12)
  year                Int      // Year
  maleFeeMonthly      Int?     // Total monthly fee for males (for tracking)
  femaleFeeMonthly    Int?     // Total monthly fee for females (for tracking)
  maleFeePerSession   Int?     // Per-session fee for males (used in PaymentRecord)
  femaleFeePerSession Int?     // Per-session fee for females (used in PaymentRecord)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, month, year])
  @@index([clubId])
  @@map("club_fee_configs")
}

// ===========================================
// Club Management Enums
// ===========================================

enum ClubJoinPolicy {
  OPEN              // Anyone can join immediately
  APPROVAL_REQUIRED // Requires admin approval
  INVITATION_ONLY   // Only invited users can join
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===========================================
// Club Join Request Model
// ===========================================

model ClubJoinRequest {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  message   String?  // Optional message from requester
  status    JoinRequestStatus @default(PENDING)
  response  String?  // Optional response from admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User @relation("UserClubJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([status])
  @@map("club_join_requests")
}

// ===========================================
// Club Announcement Model
// ===========================================

model ClubAnnouncement {
  id          String    @id @default(cuid())
  clubId      String
  authorId    String
  title       String
  content     String    @db.Text
  pinnedUntil DateTime? // Optional pinning expiration
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation("UserClubAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([authorId])
  @@index([pinnedUntil])
  @@map("club_announcements")
}

// ===========================================
// Club Session Tracking Model
// ===========================================

model ClubSession {
  id              String   @id @default(cuid())
  clubId          String
  sessionId       String
  attendanceCount Int      @default(0) // Number of club members who attended
  createdAt       DateTime @default(now())

  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([clubId, sessionId])
  @@index([clubId])
  @@index([sessionId])
  @@map("club_sessions")
}

// ===========================================
// Club Schedule Model
// ===========================================

model ClubSchedule {
  id        String  @id @default(cuid())
  clubId    String
  dayOfWeek Int     // 0=CN, 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7
  startTime String  // "19:00"
  endTime   String  // "21:00"
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_schedules")
}

