generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String? // For email/password auth
  emailVerified DateTime?
  image         String?
  imagePublicId String? // Cloudinary public ID for avatar
  role          Role      @default(PLAYER)

  // Player related information
  gender           Gender?
  level            Int? // 1-8 (Beginner to Pro)
  levelDescription String?
  phone            String?
  searchTerms      String? // Normalized search string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playerRecords      Player[]
  hostedSessions     Session[]             @relation("HostedSessions")
  accounts           Account[]
  sessions           AuthSession[]
  hostedTournaments  Tournament[]          @relation("HostedTournaments")
  managedTournaments TournamentManager[]   @relation("ManagedTournaments")
  tournamentPlayers  TournamentPlayer[]    @relation("TournamentPlayers")
  refreshTokens      RefreshToken[]
  paymentSettings    HostPaymentSettings[]
  hostPayments       PaymentRecord[]       @relation("HostPayments")
  registeredPayments PaymentRecord[]       @relation("RegisteredPayments")
  ratingsGiven       Rating[]              @relation("RatingsGiven")
  ratingsReceived    Rating[]              @relation("RatingsReceived")
  notifications      Notification[]

  // Club relations
  hostedClubs       Club[]             @relation("HostClubs")
  clubMemberships   ClubMember[]       @relation("UserClubs")
  clubJoinRequests  ClubJoinRequest[]  @relation("UserClubJoinRequests")
  clubAnnouncements ClubAnnouncement[] @relation("UserClubAnnouncements")

  // Image gallery
  uploadedImages UserImage[] @relation("UserImages")

  // Tournament referee (umpire accounts linked to this user)
  refereeUmpires TournamentUmpire[] @relation("RefereeUmpires")

  // Feedback
  feedbacks              Feedback[]     @relation("UserFeedbacks")
  submittedVenueRequests VenueRequest[] @relation("SubmittedVenueRequests")
  reviewedVenueRequests  VenueRequest[] @relation("ReviewedVenueRequests")

  // Post relations
  posts        Post[]        @relation("UserPosts")
  postLikes    PostLike[]    @relation("UserPostLikes")
  postComments PostComment[] @relation("UserPostComments")
  postShares   PostShare[]   @relation("UserPostShares")

  @@map("users")
}

// Notification System
enum NotificationType {
  SYSTEM // Admin broadcast notifications
  SESSION // Session-related notifications
  REGISTRATION // Registration status updates
  PAYMENT // Payment-related notifications
  CLUB // Club-related notifications
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional data (sessionId, playerId, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LevelDescription {
  id          String   @id @default(cuid())
  level       Int      @unique
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("level_descriptions")
}

model Session {
  id                 String        @id @default(cuid())
  slug               String?       @unique
  name               String
  description        String?
  notes              String?
  hostName           String?
  hostPhone          String?
  location           String? // Keeping for backward compatibility
  venueId            String?
  hostId             String
  numberOfCourts     Int           @default(2)
  searchTerms        String? // Normalized search string
  sessionDuration    Int           @default(120)
  maxPlayersPerCourt Int           @default(8)
  requirePlayerInfo  Boolean       @default(true)
  status             SessionStatus @default(PREPARING)
  startTime          DateTime?
  endTime            DateTime?

  // Scheduling fields: planned times vs actual times
  scheduledStartTime DateTime? // Original planned start time
  scheduledEndTime   DateTime? // Original planned end time
  gracePeriodEnd     DateTime? // End of 30-min grace period after scheduledEndTime

  // Notification tracking (prevents duplicate cron notifications)
  startReminderSentAt DateTime? // When start reminder was sent to host
  endWarningSentAt    DateTime? // When 15-min-before-end warning was sent
  cancelledAt         DateTime? // When session was auto-cancelled
  autoStartedAt       DateTime? // When session was auto-started by the system

  // Guest access settings
  allowGuestJoin  Boolean @default(true) // Allow joining without account
  allowNewPlayers Boolean @default(true) // Allow new players to join via session QR

  // Contact settings
  allowZaloContact Boolean @default(false) // Allow players to contact host via Zalo

  // Player level requirements (empty array = all levels allowed)
  requiredLevels Int[] @default([]) // Array of level IDs (1-8)

  courtColor         String    @default("#179a3b")
  defaultMatchType   MatchType @default(DOUBLES) // Default match type for courts in this session
  coverPhoto         String? // Cloudinary URL for session cover photo
  coverPhotoPublicId String? // Cloudinary public ID for cover photo
  images             String[]  @default([]) // Additional session images (max 5)
  imagePublicIds     String[]  @default([]) // Cloudinary public IDs for additional images
  shuttlecock        String?
  referenceVideoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courts    Court[]
  matches   Match[]
  players   Player[]
  host      User     @relation("HostedSessions", fields: [hostId], references: [id])
  venue     Venue?   @relation(fields: [venueId], references: [id])

  // Fee & Payment relations
  feeConfig      SessionFeeConfig?
  paymentRecords PaymentRecord[]
  expenses       SessionExpense[]
  ratings        Rating[]
  clubSessions   ClubSession[]

  @@map("sessions")
}

enum ViewTargetType {
  VENUE
  CLUB
  SESSION
}

model ViewCount {
  id         String         @id @default(cuid())
  targetType ViewTargetType
  targetId   String
  count      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType])
  @@index([targetId])
  @@map("view_counts")
}

model Venue {
  id               String            @id @default(cuid())
  slug             String?           @unique
  placeId          String?           @unique // Google Place ID
  name             String
  acronym          String? // Venue acronym
  description      String? // Venue description
  searchTerms      String? // Normalized search string
  address          String
  lat              Float?
  lng              Float?
  district         String?
  city             String?
  newAddress       String? // New admin unit address (post Nghị quyết 60)
  newDistrict      String? // New ward/district name
  newCity          String? // New city/province name if changed
  isVerified       Boolean           @default(false)
  openingHours     String?
  numberOfCourts   Int?
  status           VenueStatus       @default(ACTIVE)
  phone            String?
  website          String?
  hourlyRateFixed  Int?
  hourlyRateWalkIn Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  clubs            Club[]
  tournaments      Tournament[]
  tournamentVenues TournamentVenue[]
  venueRequests    VenueRequest[]    @relation("RequestedVenue")
  appliedRequests  VenueRequest[]    @relation("AppliedVenue")

  // Amenities
  hasCarParking Boolean?
  hasCanteen    Boolean?
  wifiName      String?
  wifiPassword  String?

  // Status & Policy
  closureStatus ClosureStatus @default(OPERATING)
  bookingPolicy String?
  locatedWithin String?

  // Images
  coverPhoto               String?
  coverPhotoPublicId       String?
  courtLayoutImage         String?
  courtLayoutImagePublicId String?
  images                   String[] @default([])
  imagePublicIds           String[] @default([])

  @@index([status])
  @@index([city])
  @@index([district])
  @@index([lat, lng])
  @@map("venues")
}

enum VenueStatus {
  ACTIVE
  INACTIVE
}

enum ClosureStatus {
  OPERATING
  PERMANENTLY_CLOSED
  TEMPORARILY_CLOSED
}

enum VenueRequestType {
  CREATE
  UPDATE
}

enum VenueRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model VenueRequest {
  id                String             @id @default(cuid())
  type              VenueRequestType
  status            VenueRequestStatus @default(PENDING)
  submittedByUserId String
  venueId           String?
  appliedVenueId    String?
  payload           Json
  adminNote         String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  submittedBy  User   @relation("SubmittedVenueRequests", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?  @relation("ReviewedVenueRequests", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  venue        Venue? @relation("RequestedVenue", fields: [venueId], references: [id], onDelete: SetNull)
  appliedVenue Venue? @relation("AppliedVenue", fields: [appliedVenueId], references: [id], onDelete: SetNull)

  @@index([submittedByUserId])
  @@index([venueId])
  @@index([appliedVenueId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("venue_requests")
}

model Player {
  id                 String             @id @default(cuid())
  sessionId          String
  userId             String? // Linked user account (optional for guests)
  createdByUserId    String? // Track who created this player during registration
  playerNumber       Int
  name               String?
  gender             Gender?
  level              Int? // 1-7 (Beginner to Pro)
  levelDescription   String?
  desire             String?
  phone              String?
  preFilledByHost    Boolean            @default(false)
  confirmedByPlayer  Boolean            @default(false)
  requireConfirmInfo Boolean            @default(false)
  currentWaitTime    Int                @default(0)
  totalWaitTime      Int                @default(0)
  waitingSince       DateTime? // Timestamp when player started waiting (for realtime calculation)
  matchesPlayed      Int                @default(0)
  status             PlayerStatus       @default(WAITING)
  currentCourtId     String?
  courtPosition      Int? // Position on court (0-3), null when not on court
  registrationStatus RegistrationStatus @default(APPROVED)

  // Club fields
  isClubMember   Boolean @default(false)
  clubId         String? // Which club's fee to apply
  clubFeeApplied Boolean @default(false)

  // Player-specific join fields
  joinCode   String    @unique // Unique join code for this player slot
  qrCodeData String? // QR code data for this player
  isJoined   Boolean   @default(false) // Whether someone has joined this slot
  isGuest    Boolean   @default(true) // True if joined without account
  joinedAt   DateTime? // When the slot was filled

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  matchPlayers MatchPlayer[]
  currentCourt Court?        @relation(fields: [currentCourtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  club         Club?         @relation(fields: [clubId], references: [id])

  // Payment relation
  paymentRecord PaymentRecord?

  @@unique([sessionId, playerNumber])
  @@index([clubId])
  @@map("players")
}

model Court {
  id                 String         @id @default(cuid())
  sessionId          String
  courtNumber        Int
  courtName          String?
  direction          CourtDirection @default(HORIZONTAL)
  status             CourtStatus    @default(EMPTY)
  currentMatchId     String?        @unique
  preSelectedPlayers Json? // JSON array of pre-selected players with positions
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  currentMatch       Match?         @relation("CurrentMatch", fields: [currentMatchId], references: [id])
  session            Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matches            Match[]        @relation("CourtMatches")
  currentPlayers     Player[]

  @@unique([sessionId, courtNumber])
  @@map("courts")
}

model Match {
  id           String        @id @default(cuid())
  sessionId    String
  courtId      String
  status       MatchStatus   @default(IN_PROGRESS)
  startTime    DateTime      @default(now())
  endTime      DateTime?
  isExtra      Boolean       @default(false) // Indicates match started after session endTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  currentCourt Court?        @relation("CurrentMatch")
  players      MatchPlayer[]
  court        Court         @relation("CourtMatches", fields: [courtId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Match result
  score            String?
  winnerIds        String?
  isDraw           Boolean? @default(false)
  notes            String?
  shuttlecockCount Float?

  @@map("matches")
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  position Int
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@unique([matchId, position])
  @@map("match_players")
}

enum Role {
  HOST
  PLAYER
  ADMIN
  REFEREE
}

enum SessionStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PlayerStatus {
  WAITING
  PLAYING
  FINISHED
  READY
  INACTIVE
}

enum CourtStatus {
  EMPTY
  IN_USE
  READY
}

enum CourtDirection {
  HORIZONTAL
  VERTICAL
}

enum MatchType {
  SINGLES
  DOUBLES
}

// ... existing enums ...

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
  SCHEDULED
  CANCELLED
}

// Tournament Management Models

model Tournament {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  startDate           DateTime
  endDate             DateTime
  hostId              String
  venueId             String?
  status              TournamentStatus @default(PREPARING)
  isPublished         Boolean          @default(false)
  scheduleType        ScheduleType?
  coverPhoto          String?
  coverPhotoPublicId  String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  host             User                      @relation("HostedTournaments", fields: [hostId], references: [id])
  venue            Venue?                    @relation(fields: [venueId], references: [id])
  categories       Category[]
  managers         TournamentManager[]
  umpires          TournamentUmpire[]
  scoringDevices   TournamentScoringDevice[]
  courts           TournamentCourt[]
  players          TournamentPlayer[]
  pairs            TournamentPair[]
  tournamentVenues TournamentVenue[]
  scheduleConfig   ScheduleConfiguration?

  @@map("tournaments")
}

enum TournamentStatus {
  PREPARING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// Per-tournament permission scopes that a host can grant to a manager.
enum TournamentPermission {
  RESULTS // Record results, live scoring, start/end matches, recalc standings
  SCHEDULE // Scheduling, court & referee assignment, umpire management
  PARTICIPANTS // Players, pairs, registrations, group assignment
  STRUCTURE // Categories, format, group creation, generate matches/brackets
}

// A user (other than the host) granted scoped management rights over a tournament.
model TournamentManager {
  id           String                 @id @default(cuid())
  tournamentId String
  userId       String
  permissions  TournamentPermission[]
  addedById    String? // User who granted the access (host or system admin)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("ManagedTournaments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("tournament_managers")
}

enum ScheduleType {
  NEXT_AVAILABLE
  ASSIGNED
}

enum TournamentCourtStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Category {
  id                     String                   @id @default(cuid())
  tournamentId           String
  name                   String
  type                   CategoryType
  registrationMode       CategoryRegistrationMode @default(TEAM)
  teamSize               Int                      @default(2)
  format                 CategoryFormat           @default(ROUND_ROBIN_TO_SE)
  hasGroupStage          Boolean                  @default(false)
  averageMatchDuration   Int?
  groupCount             Int?
  winnersPerGroup        Int?
  playersPerGroup        Int?
  matchFormat            MatchFormat              @default(BEST_OF_3)
  eliminationMatchFormat MatchFormat?
  thirdPlaceMatch        Boolean                  @default(false)
  // Per-set scoring rules. Defaults to BWF (rally to 21, win-by-2, cap 30).
  // pointCap = null means no hard cap (set ends only on winBy gap).
  pointsToWin            Int                      @default(21)
  winByTwo               Boolean                  @default(true)
  pointCap               Int?                     @default(30)
  formatConfig           Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrations CategoryRegistration[]
  groups        CategoryGroup[]
  matches       CategoryMatch[]

  @@unique([tournamentId, name])
  @@map("categories")
}

enum CategoryFormat {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  ROUND_ROBIN_TO_SE
}

enum MatchFormat {
  BEST_OF_1
  BEST_OF_3
  BEST_OF_5
}

enum CategoryType {
  MENS_SINGLE
  WOMENS_SINGLE
  MENS_DOUBLE
  WOMENS_DOUBLE
  MIXED_DOUBLE
  CUSTOM
}

enum CategoryRegistrationMode {
  INDIVIDUAL
  TEAM
}

model CategoryRegistration {
  id                 String   @id @default(cuid())
  categoryId         String
  tournamentPlayerId String?
  tournamentPairId   String?
  createdAt          DateTime @default(now())

  // Relations
  category           Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  player             TournamentPlayer?           @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)
  pair               TournamentPair?             @relation(fields: [tournamentPairId], references: [id], onDelete: Cascade)
  groupRegistrations CategoryGroupRegistration[]
  matchParticipants  CategoryMatchParticipant[]

  @@unique([categoryId, tournamentPlayerId])
  @@unique([categoryId, tournamentPairId])
  @@map("category_registrations")
}

model CategoryGroup {
  id          String   @id @default(cuid())
  categoryId  String
  groupNumber Int
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category      Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  registrations CategoryGroupRegistration[]
  matches       CategoryMatch[]

  @@unique([categoryId, groupNumber])
  @@map("category_groups")
}

model CategoryGroupRegistration {
  id                     String   @id @default(cuid())
  groupId                String
  categoryRegistrationId String
  createdAt              DateTime @default(now())

  // Relations
  group                CategoryGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([groupId, categoryRegistrationId])
  @@map("category_group_registrations")
}

model CategoryMatch {
  id           String       @id @default(cuid())
  categoryId   String
  groupId      String?
  round        String
  matchNumber  Int
  status       MatchStatus  @default(SCHEDULED)
  startTime    DateTime?
  endTime      DateTime?
  courtId      String?
  score        String?
  sets         Json?
  winnerId     String?
  isDraw       Boolean      @default(false)
  isForfeit    Boolean      @default(false) // Decided by forfeit/walkover; winnerId wins, the other side forfeited
  player1Score Int?
  player2Score Int?
  player3Score Int?
  player4Score Int?
  player1Points Int? // Manually-assigned standings points for side 1 (pointsEarning = 'manual')
  player2Points Int? // Manually-assigned standings points for side 2 (pointsEarning = 'manual')
  matchFormat  MatchFormat? // Match format for this specific match/round
  // Per-match overrides for set scoring rules. Null = inherit from category.
  pointsToWin  Int?
  winByTwo     Boolean?
  pointCap     Int?
  notes        String?

  // Live scoring fields
  refereeId    String? // Assigned referee (TournamentUmpire) for live scoring
  scoreVersion Int     @default(0) // Optimistic lock guard for rapid live updates
  pointLog     Json? // Ordered point history for exact undo (array of { side, setNumber })

  // Schedule management fields
  queueOrder        Int? // Priority order in queue for Next Available Court mode
  isQueued          Boolean   @default(false) // Whether match is waiting for court assignment
  scheduledDuration Int? // Expected match duration in minutes
  estimatedEndTime  DateTime? // Calculated end time (startTime + scheduledDuration)
  autoAssignedAt    DateTime? // When match was auto-assigned to court
  assignedBy        String? // "AUTO" or userId who manually assigned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category          Category                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group             CategoryGroup?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  court             TournamentCourt?           @relation("CourtMatches", fields: [courtId], references: [id])
  currentCourtMatch TournamentCourt?           @relation("CurrentCourtMatch")
  referee           TournamentUmpire?          @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  participants      CategoryMatchParticipant[]

  @@index([refereeId])
  @@map("category_matches")
}

model CategoryMatchParticipant {
  id                     String   @id @default(cuid())
  matchId                String
  categoryRegistrationId String
  position               Int
  createdAt              DateTime @default(now())

  // Relations
  match                CategoryMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  categoryRegistration CategoryRegistration @relation(fields: [categoryRegistrationId], references: [id], onDelete: Cascade)

  @@unique([matchId, categoryRegistrationId])
  @@unique([matchId, position])
  @@map("category_match_participants")
}

model TournamentUmpire {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  email        String?
  phone        String?
  notes        String?
  userId       String? // Linked user account (makes this umpire a login-able referee)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User?           @relation("RefereeUmpires", fields: [userId], references: [id], onDelete: SetNull)
  matches    CategoryMatch[] @relation("MatchReferee")

  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_umpires")
}

model TournamentScoringDevice {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  deviceType   String?
  deviceId     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_scoring_devices")
}

model TournamentCourt {
  id                String                @id @default(cuid())
  tournamentId      String
  tournamentVenueId String?
  courtNumber       Int
  courtName         String?
  status            TournamentCourtStatus @default(AVAILABLE)
  currentMatchId    String?               @unique
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  tournament      Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentVenue TournamentVenue? @relation(fields: [tournamentVenueId], references: [id], onDelete: SetNull)
  matches         CategoryMatch[]  @relation("CourtMatches")
  currentMatch    CategoryMatch?   @relation("CurrentCourtMatch", fields: [currentMatchId], references: [id])
  courtTimeSlots  CourtTimeSlot[]

  @@unique([tournamentId, courtNumber])
  @@map("tournament_courts")
}

model TournamentVenue {
  id           String   @id @default(cuid())
  tournamentId String
  venueId      String
  createdAt    DateTime @default(now())

  // Relations
  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venue      Venue             @relation(fields: [venueId], references: [id])
  courts     TournamentCourt[]

  @@unique([tournamentId, venueId])
  @@map("tournament_venues")
}

model TournamentPlayer {
  id               String   @id @default(cuid())
  tournamentId     String
  name             String
  email            String?
  phone            String?
  gender           Gender?
  level            Int?
  levelDescription String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                  @relation("TournamentPlayers", fields: [userId], references: [id])
  registrations CategoryRegistration[]
  pairMembers   TournamentPairMember[]

  @@map("tournament_players")
}

model TournamentPair {
  id           String        @id @default(cuid())
  tournamentId String
  name         String?
  type         CategoryType?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  tournament    Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members       TournamentPairMember[]
  registrations CategoryRegistration[]

  @@map("tournament_pairs")
}

model TournamentPairMember {
  id        String   @id @default(cuid())
  pairId    String
  playerId  String
  position  Int
  createdAt DateTime @default(now())

  // Relations
  pair   TournamentPair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  player TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([pairId, playerId])
  @@unique([pairId, position])
  @@map("tournament_pair_members")
}

// ===========================================
// Fee & Payment Management Models
// ===========================================

enum FeeType {
  FIXED
  SPLIT_EVENLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model SessionFeeConfig {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  feeType        FeeType
  maleFee        Int? // Fee for male players (in VND), nullable for SPLIT_EVENLY
  femaleFee      Int? // Fee for female players (in VND), nullable for SPLIT_EVENLY
  splitTotal     Int? // Total amount to split (for SPLIT_EVENLY), set after session
  splitPerPlayer Int? // Calculated amount per player (for SPLIT_EVENLY)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_fee_configs")
}

model HostPaymentSettings {
  id                String   @id @default(cuid())
  userId            String
  bankName          String?
  bankAccountNumber String?
  accountHolderName String?
  qrCodeUrl         String?
  qrCodePublicId    String? // Cloudinary public ID for QR code
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("host_payment_settings")
}

model PaymentRecord {
  id                 String         @id @default(cuid())
  sessionId          String
  playerId           String         @unique // One payment per player
  registeredByUserId String? // User who registered this player (for multi-slot)
  hostId             String
  amount             Int // Amount in VND
  paymentMethod      PaymentMethod?
  status             PaymentStatus  @default(PENDING)
  proofImageUrl      String?
  proofImagePublicId String? // Cloudinary public ID for payment proof
  proofNotes         String?
  hostNotes          String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  host         User    @relation("HostPayments", fields: [hostId], references: [id])
  registeredBy User?   @relation("RegisteredPayments", fields: [registeredByUserId], references: [id])

  @@index([sessionId])
  @@index([hostId])
  @@index([registeredByUserId])
  @@map("payment_records")
}

model SessionExpense {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  amount    Int // Amount in VND
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_expenses")
}

// ===========================================
// Rating & Review System Models
// ===========================================

enum RatingType {
  PLAYER_TO_HOST
  HOST_TO_PLAYER
}

model Rating {
  id          String     @id @default(cuid())
  sessionId   String
  raterUserId String // User giving the rating
  ratedUserId String // User receiving the rating
  type        RatingType // Direction of rating
  rating      Int // 1-5 stars
  comment     String? // Optional review (max 500 chars)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rater   User    @relation("RatingsGiven", fields: [raterUserId], references: [id], onDelete: Cascade)
  rated   User    @relation("RatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  // Unique constraint: one rating per (session, rater, rated, type)
  @@unique([sessionId, raterUserId, ratedUserId, type])
  @@index([ratedUserId])
  @@index([raterUserId])
  @@index([sessionId])
  @@map("ratings")
}

// ===========================================
// Fixed Member Group Management Models
// ===========================================

model Club {
  id          String  @id @default(cuid())
  slug        String? @unique
  hostId      String
  name        String // "VIP", "Thường xuyên", etc.
  hostName    String? // Provisional host name set by admin (not linked to a real user yet)
  description String?
  color       String? // Color for visual distinction
  searchTerms String? // Normalized search string

  // Club visibility and access settings
  isPublic       Boolean        @default(false)
  joinPolicy     ClubJoinPolicy @default(APPROVAL_REQUIRED)
  maxMembers     Int?
  image          String? // Cloudinary URL for club image (primary/cover)
  imagePublicId  String? // Cloudinary public ID (primary/cover)
  images         String[]       @default([]) // Multiple images functionality
  imagePublicIds String[]       @default([]) // Multiple image public IDs
  location       String? // Primary location/venue
  defaultVenueId String? // Link to default venue
  requiredLevels Int[]          @default([]) // Array of level IDs (1-8)

  // Statistics (cached for performance)
  sessionCount       Int @default(0)
  totalPlayersServed Int @default(0)

  status          ClubStatus @default(APPROVED)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host          User               @relation("HostClubs", fields: [hostId], references: [id], onDelete: Cascade)
  defaultVenue  Venue?             @relation(fields: [defaultVenueId], references: [id], onDelete: SetNull)
  members       ClubMember[]
  feeConfigs    ClubFeeConfig[]
  players       Player[]
  joinRequests  ClubJoinRequest[]
  announcements ClubAnnouncement[]
  clubSessions  ClubSession[]
  schedules     ClubSchedule[]

  @@unique([hostId, name])
  @@index([hostId])
  @@index([isPublic])
  @@map("clubs")
}

model ClubMember {
  id     String @id @default(cuid())
  clubId String
  userId String

  // Member role and status
  role   MemberRole   @default(MEMBER)
  status MemberStatus @default(ACTIVE)

  // Activity tracking
  attendanceCount Int       @default(0)
  lastAttendedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("UserClubs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId])
  @@index([role])
  @@index([status])
  @@map("club_members")
}

model ClubFeeConfig {
  id                  String   @id @default(cuid())
  clubId              String
  month               Int // Month (1-12)
  year                Int // Year
  maleFeeMonthly      Int? // Total monthly fee for males (for tracking)
  femaleFeeMonthly    Int? // Total monthly fee for females (for tracking)
  maleFeePerSession   Int? // Per-session fee for males (used in PaymentRecord)
  femaleFeePerSession Int? // Per-session fee for females (used in PaymentRecord)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, month, year])
  @@index([clubId])
  @@map("club_fee_configs")
}

// ===========================================
// Club Management Enums
// ===========================================

enum ClubJoinPolicy {
  OPEN // Anyone can join immediately
  APPROVAL_REQUIRED // Requires admin approval
  INVITATION_ONLY // Only invited users can join
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===========================================
// Club Join Request Model
// ===========================================

model ClubJoinRequest {
  id        String            @id @default(cuid())
  clubId    String
  userId    String
  message   String? // Optional message from requester
  status    JoinRequestStatus @default(PENDING)
  response  String? // Optional response from admin
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("UserClubJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([status])
  @@map("club_join_requests")
}

// ===========================================
// Club Announcement Model
// ===========================================

model ClubAnnouncement {
  id          String    @id @default(cuid())
  clubId      String
  authorId    String
  title       String
  content     String    @db.Text
  pinnedUntil DateTime? // Optional pinning expiration
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation("UserClubAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([authorId])
  @@index([pinnedUntil])
  @@map("club_announcements")
}

// ===========================================
// Club Session Tracking Model
// ===========================================

model ClubSession {
  id              String   @id @default(cuid())
  clubId          String
  sessionId       String
  attendanceCount Int      @default(0) // Number of club members who attended
  createdAt       DateTime @default(now())

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([clubId, sessionId])
  @@index([clubId])
  @@index([sessionId])
  @@map("club_sessions")
}

// ===========================================
// Club Schedule Model
// ===========================================

model ClubSchedule {
  id        String  @id @default(cuid())
  clubId    String
  dayOfWeek Int // 0=CN, 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7
  startTime String // "19:00"
  endTime   String // "21:00"
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_schedules")
}

// ===========================================
// User Image Gallery (Feature: multi-image upload)
// ===========================================

enum ImageCategory {
  SESSION_COVER
  AVATAR
  CLUB
  QR_CODE
  PAYMENT_PROOF
  OTHER
}

model UserImage {
  id           String        @id @default(cuid())
  userId       String
  url          String // Cloudinary secure URL
  publicId     String // Cloudinary public ID
  originalName String? // Original filename
  format       String? // jpg, png, webp, etc.
  width        Int?
  height       Int?
  bytes        Int?
  category     ImageCategory @default(OTHER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserImages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@map("user_images")
}

// ===========================================
// Newsfeed / Post System Models
// ===========================================

model Post {
  id       String  @id @default(cuid())
  content  String  @db.Text
  videoUrl String? // YouTube/Vimeo embed URL
  location Json? // {name, lat, lng, address}
  authorId String
  author   User    @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  images   PostImage[]
  likes    PostLike[]
  comments PostComment[]
  shares   PostShare[]

  // For repost/share
  originalPostId String?
  originalPost   Post?   @relation("PostShares", fields: [originalPostId], references: [id])
  reposts        Post[]  @relation("PostShares")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model PostImage {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  publicId String
  order    Int    @default(0)

  @@index([postId])
  @@map("post_images")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("UserPostComments", fields: [userId], references: [id], onDelete: Cascade)
  content       String   @db.Text
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostShares", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_shares")
}

// ===========================================
// Tournament Schedule Generator Models
// ===========================================

model ScheduleConfiguration {
  id                   String   @id @default(cuid())
  tournamentId         String   @unique
  categoryPriorities   Json // Ordered array of category IDs
  matchDurations       Json // { "POOL_PLAY": 60, "PLAYOFFS": 60 }
  keepScheduledMatches Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tournament Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  timeSlots  ScheduleTimeSlot[]

  @@map("schedule_configurations")
}

model ScheduleTimeSlot {
  id         String   @id @default(cuid())
  configId   String
  date       DateTime
  startTime  String // "09:00"
  endTime    String // "17:00"
  timeBuffer Int      @default(0) // minutes between matches
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  configuration ScheduleConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)
  courtSlots    CourtTimeSlot[]

  @@map("schedule_time_slots")
}

model CourtTimeSlot {
  id          String   @id @default(cuid())
  timeSlotId  String
  courtId     String
  constraints Json? // { categories?: string[], rounds?: string[], groups?: string[] }
  createdAt   DateTime @default(now())

  timeSlot ScheduleTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  court    TournamentCourt  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([timeSlotId, courtId])
  @@map("court_time_slots")
}

model GeneratedSchedule {
  id             String   @id @default(cuid())
  tournamentId   String
  configSnapshot Json // Full configuration snapshot
  assignments    Json // Array of { matchId, courtId, startTime, duration }
  conflicts      Json // Array of unresolved conflicts
  createdAt      DateTime @default(now())
  expiresAt      DateTime // Auto-delete after 1 hour

  @@index([tournamentId])
  @@index([expiresAt])
  @@map("generated_schedules")
}

// Feedback & Bug Report System
enum FeedbackType {
  CONTACT
  BUG_REPORT
}

enum FeedbackStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id            String         @id @default(cuid())
  type          FeedbackType
  userId        String
  title         String
  description   String         @db.Text
  imageUrl      String? // Screenshot URL
  imagePublicId String? // Cloudinary public ID
  status        FeedbackStatus @default(PENDING)
  adminNote     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation("UserFeedbacks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("feedbacks")
}
