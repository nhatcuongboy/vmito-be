# Database
DATABASE_URL=postgresql://username:password@host:5432/database?schema=public
DIRECT_URL=postgresql://username:password@host:5432/database?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Application
PORT=3001
NODE_ENV=development

# CORS Configuration (comma separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://mydomain.com
CORS_CREDENTIALS=true

# Default Host ID (for sessions without authentication)
DEFAULT_HOST_ID=your-default-host-id

# Optional: Prisma Data Proxy (for Vercel deployment)
# PRISMA_GENERATE_DATAPROXY=true

GEMINI_API_KEY=your-gemini-api-key

# Crawler (kèo vãng lai từ Facebook qua Apify webhook)
APIFY_WEBHOOK_SECRET=your-apify-webhook-secret

# --- Single-account setup (legacy) ---
# API token to fetch dataset items (Settings > Integrations > API tokens on Apify)
APIFY_TOKEN=your-apify-api-token

# --- Multi-account rotation setup ---
# JSON map of accountId -> API token. Each Apify Actor's webhook URL must include
# ?account=<accountId> so the backend picks the correct token.
# Example schedule distribution (4 runs/day, $0.075/run, 3 free accounts @ $5/mo):
#   account_a: cron "30 8,21 * * *"  → 2 runs/day → $4.50/mo
#   account_b: cron "30 11 * * *"    → 1 run/day  → $2.25/mo
#   account_c: cron "30 16 * * *"    → 1 run/day  → $2.25/mo
#   Total: $9.00/mo < $15.00 budget  ✅
# Webhook URL format: https://your-api-domain/webhooks/apify?secret=SECRET&account=account_a
APIFY_TOKENS={"account_a":"token_for_account_a","account_b":"token_for_account_b","account_c":"token_for_account_c"}

CRAWLER_BOT_USER_ID=your-vmito-bot-user-id

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# Zalo OAuth v4
ZALO_APP_ID=your-zalo-app-id
ZALO_SECRET_KEY=your-zalo-secret-key
ZALO_CALLBACK_URL=http://localhost:3001/api/auth/zalo/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback

FRONTEND_URL=http://localhost:3000

# Password reset email
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
RESEND_API_KEY=your-resend-api-key
MAIL_FROM="Vmito <no-reply@example.com>"
ADMIN_EMAIL=admin@example.com

# Cloudinary Configuration
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
