# Database
DATABASE_URL=postgresql://username:password@host:5432/database?schema=public
DIRECT_URL=postgresql://username:password@host:5432/database?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Application
PORT=3001
NODE_ENV=development

# CORS Configuration (comma separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://mydomain.com
CORS_CREDENTIALS=true

# Default Host ID (for sessions without authentication)
DEFAULT_HOST_ID=your-default-host-id

# Optional: Prisma Data Proxy (for Vercel deployment)
# PRISMA_GENERATE_DATAPROXY=true

GEMINI_API_KEY=your-gemini-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
