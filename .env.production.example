# Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-dockerhub-username

# Image versions (managed by CI/CD)
BACKEND_VERSION=latest
FRONTEND_VERSION=latest

# Database
POSTGRES_USER=badminton
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=badminton

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# URLs (using IP address - update when you have a domain)
FRONTEND_URL=http://139.180.145.154
BACKEND_URL=http://139.180.145.154/api
WS_URL=ws://139.180.145.154

# Optional: Gemini AI API Key
GEMINI_API_KEY=
